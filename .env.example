# Copy to .env and fill in. Container Manager and `docker compose` both read it.

# Your Tapo CLOUD password (the TP-Link account password) — used for the
# camera's tapo:// stream. This is NOT an RTSP password.
FRIGATE_TAPO_CLOUD_PASSWORD=changeme

# LAN IP of the smart plug that the Tapo app flips on camera motion:
TAPO_PLUG_HOST=192.168.1.61
# TP-Link account credentials — required for Tapo-branded plugs (P110/P115),
# leave empty for Kasa-branded plugs:
TAPO_USERNAME=
TAPO_PASSWORD=

# GID of the `videodriver` group on your Synology (grep videodriver /etc/group).
# Required for the container to open /dev/dri (Intel iGPU). Usually 937.
VIDEODRIVER_GID=937

# ntfy notification settings. The topic name IS the credential when using the
# public ntfy.sh server — pick something unguessable.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=bears-CHANGE-ME-x7k29fq
# Only needed for self-hosted ntfy with auth enabled:
NTFY_TOKEN=
